#!name=小熊油耗去开屏广告
#!desc=开屏有两条通道：小熊自营推广（自身域名 zytg 接口）与穿山甲聚合调度的穿山甲/快手/优量汇三家；本插件对两条通道的接口与素材即时空回（reject-200），不干等、避免白屏；只影响广告，不影响任何 App 功能
#!author=quietmodem
#!homepage=https://github.com/quietmodem/scripts

# 【主通道】小熊自营推广：自家接口下发、开屏素材存自家 CDN（2026-11-21 活动记录实锤：zytg.php 返回 4KB 配置后，cdn 的 /zytg/images/ 下载 113KB 素材）
^https?://www\.xiaoxiongyouhao\.com/api/zytg\.php url reject-200
^https?://cdn\.xiaoxiongyouhao\.com/zytg/ url reject-200

# 穿山甲配置请求（按包名 com.momomobile.butterfly 精确匹配，只作用于小熊油耗）
^https?://webcast-open\.douyin\.com/webcast/openapi/pangle/setting/\?.*package_name=com\.momomobile\.butterfly url reject-200

# 穿山甲 SDK 全域名族一刀切：聚合调度/竞价/拉广告/日志等所有接口（含 gromore 与 -b、1 等备用域名轮换）——该域名族只有广告 SDK 在用，无任何用户功能
^https?://[^/]*pangolin-sdk-toutiao[^/]*/ url reject-200

# 快手配置与拉广告接口（2026-11-21 实测：开屏的美团外卖广告即快手投放）
^https?://open\.e\.kuaishou\.com/rest/e/v\d+/open/(config|univ) url reject-200

# 优量汇（腾讯）SDK 接口（其素材域名 pgdt.ugdtimg.com 在开屏时段有连接，填充疑经聚合交换下发）
^https?://mi\.gdt\.qq\.com/ url reject-200
^https?://sdk\.e\.qq\.com/ url reject-200

# 广告素材层（第二道防线：即便某次决策漏过，素材也下不下来、渲染不出来）
^https?://[^/]*\.pglstatp-toutiao\.com/(obj/ad-pattern/|ad\.union\.api/|ad-app-package/) url reject-200
^https?://lf-cdn-tos\.bytescm\.com/obj/static/ad/ url reject-200
^https?://[^/]*adkwai\.com/ url reject-200
^https?://[^/]*adukwai\.com/ url reject-200
^https?://pgdt\.ugdtimg\.com/ url reject-200
# 字节签名图床的广告桶（tos-cn-p-*）与快手图床：多次开屏素材实从这两个域名直连下载
^https?://[^/]*\.douyinpic\.com/tos-cn-p- url reject-200
^https?://[^/]*webcastcdn-tos-sign\.douyinstatic\.com/ url reject-200
^https?://[^/]*\.yximgs\.com/ url reject-200

# 【实验】VIP 状态改写：借鉴 owl38383 的 Loon 插件（适配 QuanX），验证开屏是否与 vip_state 有关；仅本地改写，与服务器真实会员无关，删掉本条即停用
^https?://www\.xiaoxiongyouhao\.com/api/vip/index\.php url script-response-body https://raw.githubusercontent.com/quietmodem/scripts/refs/heads/main/quanx/rewrite/xiaoxiong/js/xiaoxiong-vip.js

hostname = www.xiaoxiongyouhao.com, cdn.xiaoxiongyouhao.com, webcast-open.douyin.com, *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao1.com, *.pangolin-sdk-toutiao-b.com, open.e.kuaishou.com, mi.gdt.qq.com, sdk.e.qq.com, *.pglstatp-toutiao.com, lf-cdn-tos.bytescm.com, *.adkwai.com, *.adukwai.com, pgdt.ugdtimg.com, *.douyinpic.com, *.douyinstatic.com, *.yximgs.com
